# Copy on the authorized staging host only. Never commit the populated file.
SEQUO_RELEASE_ID=replace_with_verified_release_id
SEQUO_SOURCE_REVISION=replace_with_exact_api_commit
SEQUO_API_IMAGE=sequo-api:staging-candidate
SEQUO_API_PORT=55828
POSTGRES_DB=sequo_staging
POSTGRES_USER=sequo_staging
POSTGRES_PASSWORD=replace_with_a_unique_database_password
JWT_SECRET=replace_with_at_least_32_random_characters
NOTIFICATION_TOKEN_ENCRYPTION_SECRET=replace_with_another_32_random_characters
# Preserve the environment's approved existing key and pending encrypted login-code continuity.
ADMIN_CODE_ENCRYPTION_SECRET=replace_with_distinct_approved_admin_code_key
CORS_ALLOWED_ORIGINS=https://replace_with_approved_admin_origin
# Approved authentication/OTP delivery configuration must be supplied securely.
# Yas/Flooz remain NOT_CONNECTED; no provider secrets or runtime simulator here.

# Admin sign-in emails: verified sender and sending-only Resend key required.
ADMIN_EMAIL_ENABLED=false
RESEND_API_KEY=
ADMIN_EMAIL_FROM=
