# Local developer profile for connecting Sequo API to a PostgreSQL database
# on your laptop. Copy this to `.env.local` if you want a local shell helper,
# but never commit `.env.local`.

SPRING_PROFILES_ACTIVE=postgres-local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sequo_db
SPRING_DATASOURCE_USERNAME=oreste
SPRING_DATASOURCE_PASSWORD=Muhirehonore@1*

# Optional local overrides.
PORT=8080
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_FLYWAY_ENABLED=false
