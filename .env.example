SEQUO_API_BIND=0.0.0.0
SEQUO_API_PORT=8080
SEQUO_POSTGRES_BIND=127.0.0.1
SEQUO_POSTGRES_PORT=5432
SEQUO_ADMINER_BIND=127.0.0.1
SEQUO_ADMINER_PORT=8081

SEQUO_API_IMAGE=sequo-api:prod
SPRING_PROFILES_ACTIVE=prod

POSTGRES_DB=sequo
POSTGRES_USER=sequo
POSTGRES_PASSWORD=replace_with_a_unique_database_password

SPRING_JPA_HIBERNATE_DDL_AUTO=validate

JWT_SECRET=replace_with_at_least_32_random_characters
NOTIFICATION_TOKEN_ENCRYPTION_SECRET=replace_with_at_least_32_random_characters
# Retain the approved existing admin-code key; do not rotate pending encrypted codes blindly.
ADMIN_CODE_ENCRYPTION_SECRET=replace_with_distinct_approved_admin_code_key
CORS_ALLOWED_ORIGINS=https://app.your-domain.com,https://admin.your-domain.com

GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_ANDROID_CLIENT_ID=543119759762-k7d6pjd4l24jf1pac78idfrffimq2ia9.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=543119759762-ehcnb5lpi883c94457ogrgqsd0nshde2.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=543119759762-5vi3qqvr26o3adoqe7v68stbic1vh2i2.apps.googleusercontent.com
FACEBOOK_APP_ID=replace_with_facebook_app_id
# Native iOS audience (bundle ID); comma-separate additional registered app IDs if needed.
APPLE_CLIENT_ID=dev.orestegabo.sequo.Sequo

# Preparation only: leave blank until the operator supplies approved environment-specific values.
# These are SEQUO config slots, not a claim about either provider's authentication protocol.
# Populating them does not connect payments/callbacks/refunds/payouts. See docs/TASK24_PROVIDER_PREPARATION.md.
YAS_TOGO_API_BASE_URL=
YAS_TOGO_API_KEY=
YAS_TOGO_MERCHANT_ACCOUNT_ID=
YAS_TOGO_WEBHOOK_SECRET=
MOOV_AFRICA_API_BASE_URL=
MOOV_AFRICA_API_KEY=
MOOV_AFRICA_MERCHANT_ACCOUNT_ID=
MOOV_AFRICA_WEBHOOK_SECRET=

API_MEMORY_LIMIT=1536m
POSTGRES_MEMORY_LIMIT=1536m
POSTGRES_SHM_SIZE=256m
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom
JAVA_OPTS=

# Admin sign-in emails: verified sender and sending-only Resend key required.
ADMIN_EMAIL_ENABLED=false
RESEND_API_KEY=
ADMIN_EMAIL_FROM=
