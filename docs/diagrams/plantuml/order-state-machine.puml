@startuml
title Target Order State Machine

skinparam shadowing false

[*] --> DRAFT
DRAFT --> PRICE_QUOTED : quote created
DRAFT --> ABANDONED : customer abandons

PRICE_QUOTED --> PAYMENT_PENDING : payment intent created
PRICE_QUOTED --> EXPIRED : quote expires

PAYMENT_PENDING --> PAID : provider confirms payment
PAYMENT_PENDING --> PAYMENT_FAILED : provider failure
PAYMENT_PENDING --> CANCELLED : customer/support cancels

PAID --> MERCHANT_PENDING : order/sub-orders generated
MERCHANT_PENDING --> ACCEPTED : merchant accepts
MERCHANT_PENDING --> REJECTED : merchant rejects
MERCHANT_PENDING --> CANCELLED : policy/support cancellation

ACCEPTED --> PREPARING
ACCEPTED --> CANCELLED_BY_SUPPORT
PREPARING --> READY_FOR_PICKUP
PREPARING --> OUT_OF_STOCK
PREPARING --> CANCELLED_BY_SUPPORT

READY_FOR_PICKUP --> IN_TRANSIT : courier pickup
READY_FOR_PICKUP --> RELAY_DEPOSITED : relay route
READY_FOR_PICKUP --> CUSTOMER_PICKUP_READY : click and collect

IN_TRANSIT --> DELIVERED : proof/PIN accepted
IN_TRANSIT --> DELIVERY_PROBLEM
IN_TRANSIT --> RELAY_DEPOSITED

RELAY_DEPOSITED --> DELIVERED : customer pickup/release
CUSTOMER_PICKUP_READY --> DELIVERED : customer pickup confirmed

DELIVERED --> RETURN_WINDOW_OPEN : eligible goods
DELIVERED --> SETTLEMENT_PENDING : no return hold

RETURN_WINDOW_OPEN --> RETURN_REQUESTED : customer opens return
RETURN_WINDOW_OPEN --> SETTLEMENT_PENDING : window expires/no return

RETURN_REQUESTED --> RETURN_DROPPED_AT_RELAY
RETURN_REQUESTED --> RETURN_EXPIRED
RETURN_REQUESTED --> RETURN_REJECTED
RETURN_DROPPED_AT_RELAY --> RETURN_RECEIVED : Sequo physical receipt
RETURN_RECEIVED --> REFUND_PENDING
RETURN_RECEIVED --> REFUND_REJECTED
REFUND_PENDING --> REFUNDED
REFUNDED --> SETTLEMENT_ADJUSTED

SETTLEMENT_PENDING --> SETTLED
SETTLEMENT_ADJUSTED --> SETTLED
SETTLED --> [*]

PAYMENT_FAILED --> [*]
CANCELLED --> [*]
REJECTED --> [*]
OUT_OF_STOCK --> [*]
CANCELLED_BY_SUPPORT --> [*]
RETURN_EXPIRED --> SETTLEMENT_PENDING
RETURN_REJECTED --> SETTLEMENT_PENDING

@enduml

